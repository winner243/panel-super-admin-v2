# Super Admin Panel
#
# Modèle des variables d'environnement.
# Duplique ce fichier en .env.local avec tes valeurs réelles (.env.local n'est jamais commité).

# --- Supabase (V1) ---
# Projet Supabase de développement uniquement.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur :
# la clé anon est publique par design, la sécurité des données repose sur RLS.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<cle-anon-publique>"

# Serveur uniquement, jamais dans le navigateur ni dans un fichier commité.
# SUPABASE_SERVICE_ROLE_KEY="<cle-service-role>"